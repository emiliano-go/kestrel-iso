#!/bin/bash

# Live ISO only: install Kestrel onto the target disk from the ISO's bundled
# offline repository. Launched from the Super + D menu ("Install Kestrel").

set -euo pipefail

if (( EUID != 0 )); then
  echo "kestrel-install must run as root (use sudo)." >&2
  exit 1
fi

export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="$KESTREL_PATH/install"
export KESTREL_INSTALL_LOG_FILE="/var/log/kestrel-install.log"

# Installer helpers live on the ISO (this repo owns installation orchestration).
source /root/helpers/all.sh

# Tokyo Night colors for the installer's virtual console.
set_tokyo_night_colors() {
  [[ $(tty) == "/dev/tty"* ]] || return 0
  local p
  for p in "02b2b2b" "1cb3810" "2cb3810" "3cb3810" "4cb3810" "5cb3810" "6cb3810" "7d0d0d0" \
    "83a3a3a" "9cb3810" "Acb3810" "Bcb3810" "Ccb3810" "Dcb3810" "Ecb3810" "Fededed"; do
    printf '\e]P%s' "$p"
  done
  printf '\033[0m'
  clear
}

# The configurator (from the ISO's root home) writes user_configuration.json and
# user_credentials.json next to itself.
run_configurator() {
  set_tokyo_night_colors
  (cd /root && ./configurator)
  KESTREL_USER="$(jq -r '.users[0].username' /root/user_credentials.json)"
  export KESTREL_USER
}

install_arch() {
  clear_logo
  gum style --foreground 3 --padding "1 0 0 $PADDING_LEFT" "Installing..."
  echo

  touch "$KESTREL_INSTALL_LOG_FILE"

  start_log_output
  CURRENT_SCRIPT="install_base_system"
  install_base_system > >(sed -u 's/\x1b\[[0-9;]*[a-zA-Z]//g' >>"$KESTREL_INSTALL_LOG_FILE") 2>&1
  unset CURRENT_SCRIPT
  stop_log_output
}

install_kestrel() {
  clear_logo
  gum style --foreground 3 --padding "1 0 0 $PADDING_LEFT" "Setting up Kestrel..."
  echo

  start_log_output
  CURRENT_SCRIPT="deploy_kestrel"
  deploy_kestrel > >(sed -u 's/\x1b\[[0-9;]*[a-zA-Z]//g' >>"$KESTREL_INSTALL_LOG_FILE") 2>&1
  unset CURRENT_SCRIPT
  stop_log_output

  if [[ -f /mnt/var/tmp/kestrel-install-completed ]]; then
    reboot
  fi
}

install_base_system() {
  # Initialize and populate the keyring
  pacman-key --init
  pacman-key --populate archlinux

  # Sync the offline database so pacman can find packages
  pacman -Sy --noconfirm

  # Ensure that no mounts exist from past install attempts
  findmnt -R /mnt >/dev/null && umount -R /mnt

  # Install using files generated by the configurator. Offline: skip NTP, WKD and
  # the wireless check; the keyring is pre-populated in the ISO.
  archinstall \
    --config /root/user_configuration.json \
    --creds /root/user_credentials.json \
    --silent \
    --skip-ntp \
    --skip-wkd \
    --skip-wifi-check

  # After archinstall sets up the base system but before the Kestrel setup runs,
  # put the offline pacman.conf in place and mount the ISO's bundled repo.
  cp /etc/pacman.conf /mnt/etc/pacman.conf

  mkdir -p /mnt/var/cache/kestrel/mirror/offline
  mount --bind /var/cache/kestrel/mirror/offline /mnt/var/cache/kestrel/mirror/offline

  mkdir -p /mnt/opt/packages
  mount --bind /opt/packages /mnt/opt/packages
}

# Deploy the payload into the target and run its root-side and per-user setup.
deploy_kestrel() {
  local packages

  # 1. Copy the payload to its installed location.
  mkdir -p /mnt/usr/share
  rm -rf /mnt/usr/share/kestrel
  cp -rp "$KESTREL_PATH" /mnt/usr/share/kestrel
  rm -rf /mnt/usr/share/kestrel/.git
  find /mnt/usr/share/kestrel/bin -maxdepth 1 -type f -exec chmod +x {} +

  # 2. Install the Arch and AUR package set from the ISO's bundled repo. The AUR
  #    list pins a version as name=version, so strip it for the package name.
  packages=$(grep -hvE '^[[:space:]]*(#|$)' \
    /mnt/usr/share/kestrel/install/kestrel-base.packages \
    /mnt/usr/share/kestrel/install/kestrel-other.packages \
    /mnt/usr/share/kestrel/install/kestrel-aur.packages |
    sed -E 's/=.*$//' | sort -u | tr '\n' ' ')
  chroot_root pacman -S --noconfirm --needed $packages

  # 3. Root-side setup: deploys Kestrel files, configures the system, and runs
  #    hardware detection.
  chroot_root kestrel apply system --install-user "$KESTREL_USER" --first-install

  # 4. Per-user finalization (skill symlinks, xdg dirs, install/user/*).
  chroot_user kestrel finalize user --first-install
}

chroot_root() {
  arch-chroot /mnt/ env \
    PATH="/usr/share/kestrel/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
    "$@"
}

chroot_user() {
  arch-chroot -u "$KESTREL_USER" /mnt/ \
    env \
    USER="$KESTREL_USER" \
    HOME="/home/$KESTREL_USER" \
    KESTREL_FIRST_INSTALL=1 \
    PATH="/usr/share/kestrel/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
    "$@"
}

run_configurator
install_arch
install_kestrel
