#!/bin/bash

# Live ISO only: install Kestrel onto the target disk by copying the live root
# filesystem to it (the casper/anaconda model). Launched from the Super + D menu
# ("Install Kestrel").

set -euo pipefail

if (( EUID != 0 )); then
  echo "kestrel-install must run as root (use sudo)." >&2
  exit 1
fi

export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="$KESTREL_PATH/install"
export KESTREL_INSTALL_LOG_FILE="/var/log/kestrel-install.log"

# Installer helpers live on the ISO (this repo owns installation orchestration).
source /root/helpers/all.sh

TARGET=/mnt
CRYPT_NAME=cryptroot

# Tokyo Night colors for the installer's virtual console.
set_tokyo_night_colors() {
  [[ $(tty) == "/dev/tty"* ]] || return 0
  local p
  for p in "02b2b2b" "1cb3810" "2cb3810" "3cb3810" "4cb3810" "5cb3810" "6cb3810" "7d0d0d0" \
    "83a3a3a" "9cb3810" "Acb3810" "Bcb3810" "Ccb3810" "Dcb3810" "Ecb3810" "Fededed"; do
    printf '\e]P%s' "$p"
  done
  printf '\033[0m'
  clear
}

step() {
  clear_logo
  echo
  gum style --foreground 3 --padding "1 0 0 $PADDING_LEFT" "$1"
  echo
}

# ── Answers ──────────────────────────────────────────────────────────────────
# The configurator writes archinstall-shaped JSON; we read only the fields we
# need and ignore the rest (no archinstall is invoked).

read_answers() {
  local config=/root/user_configuration.json creds=/root/user_credentials.json

  KESTREL_DEFER=0
  [[ -e /root/defer-provisioning ]] && KESTREL_DEFER=1

  if ((KESTREL_DEFER)); then
    KESTREL_USER=""
    KESTREL_PASSWORD_HASH=""
    KESTREL_PASSWORD=""
  else
    KESTREL_USER="$(jq -r '.users[0].username' "$creds")"
    KESTREL_PASSWORD_HASH="$(jq -r '.users[0].enc_password' "$creds")"
    KESTREL_PASSWORD="$(jq -r '.encryption_password // empty' "$creds")"
  fi

  DISK="$(jq -r '.disk_config.device_modifications[0].device' "$config")"
  KESTREL_DISK_MODE="$(jq -r '.kestrel_disk_mode // "full"' "$config")"
  HOSTNAME="$(jq -r '.hostname // "kestrel"' "$config")"
  TIMEZONE="$(jq -r '.timezone // "UTC"' "$config")"
  KEYBOARD="$(jq -r '.locale_config.kb_layout // "us"' "$config")"
  SYS_LANG="$(jq -r '.locale_config.sys_lang // "en_US.UTF-8"' "$config")"

  KESTREL_USER_NAME="$(cat /root/user_full_name.txt 2>/dev/null || true)"
  KESTREL_USER_EMAIL="$(cat /root/user_email_address.txt 2>/dev/null || true)"

  if jq -e '.disk_config.disk_encryption' "$config" >/dev/null 2>&1; then
    KESTREL_ENCRYPTED=1
  else
    KESTREL_ENCRYPTED=0
  fi

  # A deferred install re-keys LUKS to the owner's password on first boot, so the
  # install passphrase is a random throwaway staged as a key file.
  if ((KESTREL_DEFER && KESTREL_ENCRYPTED)); then
    KESTREL_LUKS_KEYFILE=/root/kestrel-luks-key
    head -c 32 /dev/urandom | base64 >"$KESTREL_LUKS_KEYFILE"
    chmod 600 "$KESTREL_LUKS_KEYFILE"
  elif ((KESTREL_ENCRYPTED)); then
    [[ -n $KESTREL_PASSWORD ]] || abort "Encrypted install has no passphrase"
  fi

  if ((!KESTREL_DEFER)); then
    [[ -n $KESTREL_USER && $KESTREL_USER != null ]] || abort "No user in credentials"
  fi
  [[ -b $DISK ]] || abort "Target disk not found: $DISK"
}

run_configurator() {
  set_tokyo_night_colors
  (cd /root && ./configurator)
}

# ── Partition + mount ────────────────────────────────────────────────────────

partition_target() {
  step "Partitioning $DISK..."

  if [[ $KESTREL_DISK_MODE == "free-space" ]]; then
    local region
    region="$(kestrel_largest_free_region "$DISK")" || abort "No usable free space on $DISK"
    read -r free_start free_end <<<"$region"
    kestrel_create_partitions "$DISK" "$free_start" "$free_end"
  else
    sgdisk -Z "$DISK"
    kestrel_settle_disk "$DISK"
    kestrel_create_partitions "$DISK" 2048 0
  fi

  BIOS_PART="$(kestrel_part_path "$DISK" "$KESTREL_PART_BIOS")"
  ESP_PART="$(kestrel_part_path "$DISK" "$KESTREL_PART_ESP")"
  ROOT_PART="$(kestrel_part_path "$DISK" "$KESTREL_PART_ROOT")"

  if ((KESTREL_ENCRYPTED)); then
    if [[ -n ${KESTREL_LUKS_KEYFILE:-} ]]; then
      cryptsetup luksFormat --type luks2 --pbkdf argon2id --iter-time 2000 \
        --label kestrel --key-file "$KESTREL_LUKS_KEYFILE" "$ROOT_PART"
      cryptsetup open --key-file "$KESTREL_LUKS_KEYFILE" "$ROOT_PART" "$CRYPT_NAME"
    else
      printf '%s' "$KESTREL_PASSWORD" |
        cryptsetup luksFormat --type luks2 --pbkdf argon2id --iter-time 2000 \
          --label kestrel "$ROOT_PART" -
      printf '%s' "$KESTREL_PASSWORD" |
        cryptsetup open --key-file - "$ROOT_PART" "$CRYPT_NAME"
    fi
    ROOT_DEV="/dev/mapper/$CRYPT_NAME"
    LUKS_UUID="$(cryptsetup luksUUID "$ROOT_PART")"
  else
    ROOT_DEV="$ROOT_PART"
    LUKS_UUID=""
  fi

  mkfs.btrfs -f -L kestrel "$ROOT_DEV"
  mount "$ROOT_DEV" "$TARGET"
  local sv
  for sv in @ @home @log @pkg; do btrfs subvolume create "$TARGET/$sv" >/dev/null; done
  umount "$TARGET"

  mount -o compress=zstd,subvol=@ "$ROOT_DEV" "$TARGET"
  mkdir -p "$TARGET/home" "$TARGET/var/log" "$TARGET/var/cache/pacman/pkg" "$TARGET/boot"
  mount -o compress=zstd,subvol=@home "$ROOT_DEV" "$TARGET/home"
  mount -o compress=zstd,subvol=@log "$ROOT_DEV" "$TARGET/var/log"
  mount -o compress=zstd,subvol=@pkg "$ROOT_DEV" "$TARGET/var/cache/pacman/pkg"

  mkfs.fat -F32 -n KESTREL "$ESP_PART"
  mount "$ESP_PART" "$TARGET/boot"

  ESP_UUID="$(blkid -s UUID -o value "$ESP_PART")"
}

# ── Copy ─────────────────────────────────────────────────────────────────────

copy_rootfs() {
  step "Copying the Kestrel system to disk..."
  rsync -aHAX --numeric-ids --info=progress2 \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/lost+found \
    --exclude=/var/tmp --exclude='/var/log/*' --exclude='/var/cache/*' \
    --exclude=/var/lib/systemd/random-seed --exclude=/var/lib/systemd/timesync \
    --exclude='/var/lib/pacman/sync/*' --exclude=/etc/machine-id \
    --exclude='/etc/ssh/ssh_host_*' --exclude=/home/kestrel \
    --exclude=/root \
    / "$TARGET/"
}

# ── Target setup (chroot) ────────────────────────────────────────────────────

run_target_setup() {
  step "Configuring the installed system..."

  # Hand the answers to the in-chroot script.
  {
    printf 'KESTREL_USER=%q\n' "$KESTREL_USER"
    printf 'KESTREL_PASSWORD_HASH=%q\n' "$KESTREL_PASSWORD_HASH"
    printf 'KESTREL_USER_NAME=%q\n' "$KESTREL_USER_NAME"
    printf 'KESTREL_USER_EMAIL=%q\n' "$KESTREL_USER_EMAIL"
    printf 'KESTREL_HOSTNAME=%q\n' "$HOSTNAME"
    printf 'KESTREL_TIMEZONE=%q\n' "$TIMEZONE"
    printf 'KESTREL_KEYBOARD=%q\n' "$KEYBOARD"
    printf 'KESTREL_SYS_LANG=%q\n' "$SYS_LANG"
    printf 'KESTREL_DISK=%q\n' "$DISK"
    printf 'KESTREL_ROOT_DEV=%q\n' "$ROOT_DEV"
    printf 'KESTREL_ROOT_PART=%q\n' "$ROOT_PART"
    printf 'KESTREL_LUKS_UUID=%q\n' "$LUKS_UUID"
    printf 'KESTREL_ESP_UUID=%q\n' "$ESP_UUID"
    printf 'KESTREL_ENCRYPTED=%q\n' "$KESTREL_ENCRYPTED"
    printf 'KESTREL_DEFER=%q\n' "$KESTREL_DEFER"
  } >"$TARGET/root/kestrel-target.env"

  install -Dm755 /usr/local/lib/kestrel-target-setup "$TARGET/root/kestrel-target-setup"
  cp -f /etc/resolv.conf "$TARGET/etc/resolv.conf" 2>/dev/null || true

  # Stage the throwaway LUKS key for the deferred re-key on first boot.
  if [[ -n ${KESTREL_LUKS_KEYFILE:-} ]]; then
    install -Dm600 "$KESTREL_LUKS_KEYFILE" "$TARGET/root/kestrel-luks-key"
  fi

  arch-chroot "$TARGET" /root/kestrel-target-setup
}

finalize_user() {
  if ((KESTREL_DEFER)); then
    return 0
  fi
  step "Finalizing the user account..."
  arch-chroot -u "$KESTREL_USER" "$TARGET" \
    env USER="$KESTREL_USER" HOME="/home/$KESTREL_USER" KESTREL_FIRST_INSTALL=1 \
    PATH="$KESTREL_PATH/bin:/usr/local/sbin:/usr/local/bin:/usr/bin" \
    kestrel finalize user --first-install
}

finish() {
  # The bundled Node tarball has been consumed (mise-work at install time, or
  # staged for deferred first boot); it does not belong on the installed system.
  rm -rf "$TARGET/opt/packages"
  mirror_install_log
  touch "$TARGET/var/tmp/kestrel-install-completed" 2>/dev/null || true
  umount -R "$TARGET" 2>/dev/null || true
  sync
  reboot
}

run_logged_phase() {
  start_log_output
  CURRENT_SCRIPT="$1"
  "$1" > >(sed -u 's/\x1b\[[0-9;]*[a-zA-Z]//g' >>"$KESTREL_INSTALL_LOG_FILE") 2>&1
  unset CURRENT_SCRIPT
  stop_log_output
}

touch "$KESTREL_INSTALL_LOG_FILE"

# The Kestrel VM helper shares the host log directory as a 9p mount tagged
# kestrel_host_logs. Mirror the installer log there (and into the target) so a
# failed install can still be read from the host or the installed system.
KESTREL_HOST_LOG_DIR=/mnt/kestrel-host-logs
mirror_install_log() {
  install -Dm644 "$KESTREL_INSTALL_LOG_FILE" "$TARGET/var/log/kestrel-install.log" 2>/dev/null || true
  mkdir -p "$KESTREL_HOST_LOG_DIR"
  if mountpoint -q "$KESTREL_HOST_LOG_DIR" ||
    mount -t 9p -o trans=virtio,version=9p2000.L kestrel_host_logs "$KESTREL_HOST_LOG_DIR" 2>/dev/null; then
    cp -f "$KESTREL_INSTALL_LOG_FILE" "$KESTREL_HOST_LOG_DIR/" 2>/dev/null || true
  fi
}
trap mirror_install_log EXIT

run_configurator
read_answers
run_logged_phase partition_target
run_logged_phase copy_rootfs
run_logged_phase run_target_setup
run_logged_phase finalize_user
finish
