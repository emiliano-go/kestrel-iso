#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: kestrel-iso-release [version]"
  exit 1
fi

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
BULD_VERSION="$1"

# Make ISOs
if [[ $1 != "--no-make" ]]; then
  echo -e "\e[32mMaking ISO\e[0m"
  KESTREL_INSTALLER_REF=main kestrel-iso-make --no-cache --no-boot-offer
else
  echo -e "\e[31mSkipping remaking ISOs\e[0m"
fi

# Sign ISO
latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/kestrel-*-x86_64.iso | head -n1)
release_iso="$BUILD_RELEASE_PATH/kestrel-$BULD_VERSION.iso"
cp "$latest_iso" "$release_iso"

echo -e "\e[32mSigning ISO\e[0m"
kestrel-iso-sign "$release_iso"

iso_sha=$(sha256sum "$release_iso")
echo -e "\e[32mSHA256 for ISO: $iso_sha\e[0m"
