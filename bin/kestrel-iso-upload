#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: kestrel-iso-upload [release/kestrel.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: kestrel-iso-rclone-config"
  exit 1
fi

rclone copy $1 Kestrel:kestrel/ -P

if [[ -f $1.sig ]]; then
  rclone copy $1.sig Kestrel:kestrel/ -P
fi
