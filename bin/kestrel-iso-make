#!/bin/bash

# Abort if anything fails
set -e

# Parse command line arguments
NO_CACHE=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --no-cache)
    NO_CACHE=1
    shift
    ;;
  --no-boot-offer)
    NO_BOOT_OFFER=1
    shift
    ;;
  --local-source)
    LOCAL_SOURCE=1
    shift
    ;;
  --dev)
    KESTREL_INSTALLER_REF=dev
    shift
    ;;
  --vault)
    VAULT_DIR="$2"
    shift 2
    ;;
  --vault-size)
    VAULT_SIZE="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 [--no-cache] [--no-boot-offer] [--local-source] [--dev] [--vault FOLDER] [--vault-size SIZE]"
    exit 1
    ;;
  esac
done

# Ensure we have the submodule checked out
git submodule update --init --recursive --jobs=8

# Prepare build repo
BUILD_SCRIPT="builder/build-iso.sh"
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
mkdir -p "$BUILD_RELEASE_PATH"

KESTREL_INSTALLER_REPO="${KESTREL_INSTALLER_REPO:-kestrel-distro/kestrel}"
KESTREL_INSTALLER_REF="${KESTREL_INSTALLER_REF:-main}"

DOCKER_ARGS=(
  --rm
  --privileged
  -e "KESTREL_INSTALLER_REPO=$KESTREL_INSTALLER_REPO"
  -e "KESTREL_INSTALLER_REF=$KESTREL_INSTALLER_REF"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -v "$BUILD_RELEASE_PATH/:/out/"
  -v "$BUILD_ROOT/$BUILD_SCRIPT:/$BUILD_SCRIPT:ro"
  -v "$BUILD_ROOT/archiso:/archiso:ro"
  -v "$BUILD_ROOT/builder:/builder:ro"
  -v "$BUILD_ROOT/configs:/configs:ro"
)

# Use the local Kestrel checkout instead of a git clone. Defaults to the sibling
# ../kestrel so the normal layout works with no environment set.
if [[ -n "${LOCAL_SOURCE-}" ]]; then
  LOCAL_SOURCE_PATH="${KESTREL_PATH:-$BUILD_ROOT/../kestrel}"
  [[ -d $LOCAL_SOURCE_PATH ]] || {
    echo "Local Kestrel source not found: $LOCAL_SOURCE_PATH" >&2
    exit 1
  }
  DOCKER_ARGS+=(-v "$LOCAL_SOURCE_PATH:/kestrel:ro")
fi

# A dedicated pacman cache, separate from the host's, so the build never reads a
# differently-built package the system's pacman happens to have under the same
# name. Persists across runs so repeat builds stay fast.
PACMAN_CACHE_DIR="$HOME/.cache/kestrel/pacman-pkg"
mkdir -p "$PACMAN_CACHE_DIR"
DOCKER_ARGS+=(-v "$PACMAN_CACHE_DIR:/var/cache/pacman/pkg")

# Reuse the AUR packages built by previous runs. Arch packages come from the
# host pacman cache mounted above.
if [[ -z "$NO_CACHE" ]]; then
  AUR_CACHE_DIR="$HOME/.cache/kestrel/aur-packages"
  mkdir -p "$AUR_CACHE_DIR"
  DOCKER_ARGS+=(-v "$AUR_CACHE_DIR:/var/cache/aur-packages" -e "KESTREL_AUR_CACHE=/var/cache/aur-packages")
fi

# Run the builder with assembled args
docker run "${DOCKER_ARGS[@]}" archlinux/archlinux:latest /$BUILD_SCRIPT

# Tag non-default builds with their ref so branches do not overwrite each
# other; the default branch needs no suffix.
latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*.iso | head -n1)
iso_ref="$latest_iso"
if [[ $KESTREL_INSTALLER_REF != main ]]; then
  iso_ref="${latest_iso%.*}-$KESTREL_INSTALLER_REF.iso"
  mv -f "$latest_iso" "$iso_ref"
fi

# Embed the encrypted vault, if a folder was given. This is the same injection
# path as the post-build tool (kestrel-iso-vault add), so a vault built into a
# fresh ISO and one added to a compiled ISO behave identically.
if [[ -n ${VAULT_DIR:-} ]]; then
  vault_args=(add "$iso_ref" "$VAULT_DIR" --out "$iso_ref.vault.iso")
  [[ -n ${VAULT_SIZE:-} ]] && vault_args+=(--size "$VAULT_SIZE")
  "${BASH_SOURCE[0]%/*}/kestrel-iso-vault" "${vault_args[@]}"
  mv -f "$iso_ref.vault.iso" "$iso_ref"
fi

# Offer to boot the new build
if [[ -z "$NO_BOOT_OFFER" ]]; then
  echo
  gum confirm "Boot $iso_ref?" && kestrel-iso-boot "$iso_ref"
fi
